# Clippn has no hosted backend -- every value below points at services you
# run yourself on your own machine (see README.md "Local infrastructure").

# Local Postgres, created via `createdb clipforge_dev`
DATABASE_URL=postgresql://localhost/clipforge_dev

# Local Redis (session-only provider credential storage)
REDIS_URL=redis://127.0.0.1:6379

# 32-byte key, base64-encoded, generated once per local install:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Protects "remember securely" provider credentials at rest. Never commit a
# real value. Losing this key makes previously-remembered credentials
# unrecoverable -- reconnect the provider instead of trying to recover it.
CREDENTIAL_MASTER_KEY=
